{
  "name": "all-gas-hackathon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "#_": "# run these via `vp run <foo>`",
    "#dev": "# `dev` runs both frontend and backend",
    "#dev:web": "# `dev:web` runs only the vite server",
    "#dev:backend": "# `dev:backend` runs only the convex backend",
    "build": "tsc && vp build",
    "preview": "vp preview",
    "prepare": "vp config",
    "deploy:dev": "pnpm exec static-hosting upload --build",
    "deploy": "pnpm exec static-hosting deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@convex-dev/static-hosting": "^0.2.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@shadcn/react": "^0.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.45.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.28.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "download"
    }
  }
}
